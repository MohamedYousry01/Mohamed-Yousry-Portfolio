---
import Layout from '../layouts/Layout.astro';
import {profile,href,expertise,skills} from '../data/profile';
import Icon from '../components/Icon.astro';
import ProjectGroups from '../components/ProjectGroups.astro';
import Timeline from '../components/Timeline.astro';
import ContactBlock from '../components/ContactBlock.astro';
import EngineeringExplorer from '../components/EngineeringExplorer';
import Diagram from '../components/Diagram';
import ComplianceSection from '../components/ComplianceSection.astro';
import portrait from '../assets/mohamed-yousry.png';
---
<Layout>
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow hero-eyebrow"><span class="status-dot"/> EMBEDDED SOFTWARE · CYBERSECURITY · MEDICAL DEVICES</span><div class="hero-identity"><img class="hero-avatar" src={portrait.src} alt="Mohamed Yousry" width="144" height="144" loading="eager" decoding="async"/><p class="hero-name">Mohamed Yousry <span>/ {profile.title}</span></p></div><h1>Embedded Firmware,<br/><span>Control Systems</span> & Cybersecurity.</h1><p class="hero-description">{profile.description}</p><div class="hero-actions"><a class="button primary" href="#work">Explore my work <Icon name="arrow" size={18}/></a>{profile.resume?<a class="button secondary" href={href(profile.resume)} download={profile.resumeDownloadName}>View resume <Icon name="download" size={17}/></a>:<a class="button secondary" href={href('experience/')}>View resume <Icon name="arrow" size={17}/></a>}</div><div class="hero-social"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={16}/> LinkedIn <span>↗</span></a>{profile.github?<a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>:<span class="unconfigured">GitHub <span class="small">/ to be added</span></span>}</div></div><div class="hero-art"><div class="art-top"><span><span class="status-dot"/> SYSTEM ARCHITECTURE</span><span>MY / 01</span></div><Diagram scene={0} id="hero-chip"/><div class="art-bottom"><span><Icon name="shield" size={16}/> Hardware-backed security</span><span><Icon name="activity" size={16}/> Real-time control</span></div><div class="art-note"><span class="note-icon"><Icon name="check" size={22}/></span><span>Medical device firmware<br/><strong>Control, security & verification</strong></span></div></div></div></section>
  <div class="credentials-strip"><div class="container"><span>4+ years <small>PROFESSIONAL EXPERIENCE</small></span><span>Medical devices <small>SAFETY-CRITICAL FIRMWARE</small></span><span>Hardware-backed <small>EMBEDDED CYBERSECURITY</small></span><span>Firmware & control <small>EMBEDDED SYSTEMS</small></span></div></div>
  <section class="section container" id="expertise"><div class="section-heading"><div><span class="eyebrow">01 / ENGINEERING EXPERTISE</span><h2>Engineering expertise</h2></div><p>Firmware and control, embedded security, secure boot, quality-management processes, and verification.</p></div><div class="expertise-grid">{expertise.map(e=><article class="expertise-card"><div class="icon-tile"><Icon name={e.icon}/></div><h3>{e.title}</h3><p>{e.description}</p><span class="expertise-tags">{e.tags}</span>{e.link&&<a class="text-link expertise-action" href={href(e.link)}>Explore compliance <Icon name="arrow" size={16}/></a>}</article>)}</div></section>
  <section class="section systems-section" id="systems"><div class="container"><div class="section-heading"><div><span class="eyebrow">02 / INSIDE THE ENGINEERING</span><h2>System architectures</h2></div><p>Animated sequences for firmware, security, secure boot, quality management, and verification.</p></div><EngineeringExplorer client:visible/><noscript><p class="notice">Static architectures and explanations for these engineering areas are available on the <a href={href('projects/')}>case-study pages</a>. Enable JavaScript to switch scenes here.</p></noscript></div></section>
  <section class="section container" id="work"><div class="section-heading"><div><span class="eyebrow">03 / SELECTED WORK</span><h2>Project case studies</h2></div><div><p>Engineering contributions, technical decisions, and verification approaches.</p><a class="text-link" href={href('projects/')}>View all projects <Icon name="arrow" size={18}/></a></div></div><ProjectGroups/><p class="disclosure"><Icon name="shield" size={15}/> These case studies highlight my engineering contributions. Diagrams are conceptual, and confidential implementation details are omitted.</p></section>
  <section class="section experience-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">04 / EXPERIENCE & EDUCATION</span><h2>Experience & education</h2></div><a class="text-link" href={href('experience/')}>Explore my experience <Icon name="arrow" size={18}/></a></div><Timeline compact/></div></section>
  <section class="section container"><div class="section-heading"><div><span class="eyebrow">05 / TECHNICAL TOOLKIT</span><h2>Technical skills</h2></div><p>Platforms, languages, algorithms, tools, and engineering standards.</p></div><div class="skills-grid">{skills.map((s,i)=><article><span class="skill-number">0{i+1}</span><h3>{s.title}</h3><ul>{s.items.map(item=><li>{item}</li>)}</ul></article>)}</div><p class="learning-note">Currently exploring <strong>Embedded Linux, Yocto, and C++</strong> as learning interests.</p></section>
  <ComplianceSection/>
  <ContactBlock/>
</Layout>


