---
import Layout from '../layouts/Layout.astro';
import {profile,href} from '../data/profile';
import Icon from '../components/Icon.astro';
---
<Layout title="Contact">
  <section class="container page-heading"><span class="eyebrow">CONTACT / LET’S CONNECT</span><h1>Start a conversation.<br/><span>Build something dependable.</span></h1><p>Connect about embedded software, firmware security, real-time control, and medical-device engineering.</p></section>
  <section class="section container contact-grid"><a class="contact-card active" href={profile.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={28}/><h2>LinkedIn</h2><p>Connect with Mohamed Yousry.</p><span class="text-link">yousry01 <Icon name="external" size={16}/></span></a><div class="contact-card"><Icon name="mail" size={28}/><h2>Email</h2>{profile.email?<a href={`mailto:${profile.email}`}>{profile.email}</a>:<p class="muted">A public email address will be added.<br/>Please use LinkedIn to get in touch.</p>}</div><div class="contact-card"><Icon name="cpu" size={28}/><h2>GitHub</h2>{profile.github?<a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">View GitHub <Icon name="external" size={16}/></a>:<p class="muted">A verified GitHub profile will be linked here when supplied.</p>}</div><div class="contact-card"><Icon name="download" size={28}/><h2>Resume</h2>{profile.resume?<a class="text-link" href={href(profile.resume)} download={profile.resumeDownloadName}>Download resume <Icon name="download" size={16}/></a>:<><p class="muted">The downloadable file will be added when supplied.</p><a class="text-link" href={href('experience/')}>View experience <Icon name="arrow" size={16}/></a></>}</div><a class="contact-card contact-whatsapp" href={profile.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={`Message Mohamed Yousry on WhatsApp at ${profile.phone}`}><Icon name="message" size={28}/><h2>WhatsApp</h2><p>{profile.phone}</p><span class="text-link">Message on WhatsApp <Icon name="external" size={16}/></span></a></section>
  <section class="container contact-note"><span class="eyebrow">AREAS OF WORK</span><p>Embedded firmware · Hardware-backed security · Secure boot & updates · Medical-device software · Real-time control · Brushless DC motor control · Verification & validation</p></section>
</Layout>

