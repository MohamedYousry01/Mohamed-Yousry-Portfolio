---
import { profile, href } from '../data/profile';
import Icon from './Icon.astro';
---
<section class="contact-band"><div class="container contact-band-inner"><div><span class="eyebrow">CONTACT</span><h2>Contact Mohamed Yousry</h2><p>Connect about embedded software, firmware security,<br class="desktop-only"/> and safety-critical systems engineering.</p></div><div class="contact-actions"><a class="button primary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <Icon name="external" size={17}/></a><a class="text-link" href={profile.whatsapp} target="_blank" rel="noopener noreferrer">Message on WhatsApp <Icon name="message" size={17}/></a><a class="text-link" href={href('contact/')}>All contact details <Icon name="arrow" size={17}/></a></div></div></section>
