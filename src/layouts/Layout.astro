---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { profile, href } from '../data/profile';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string }
const { title = 'Embedded Software & Cybersecurity Engineer', description = profile.description } = Astro.props;
const pageTitle = `${title} | ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const current = Astro.url.pathname;
const nav = [['Projects', 'projects/'], ['About', 'about/'], ['Experience', 'experience/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="color-scheme" content="light"/>
    <meta name="theme-color" content="#ffffff"/>
    <title>{pageTitle}</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')}/>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={new URL(href('social-card.png'), canonical.origin)}/>
    <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Mohamed Yousry — Embedded Software & Cybersecurity Engineer"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <ClientRouter/>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href()} aria-label="Mohamed Yousry, home"><span class="brand-mark">MY<span>.</span></span><span class="brand-name">Mohamed Yousry<span>EMBEDDED SYSTEMS ENGINEER</span></span></a>
        <nav class="desktop-nav" aria-label="Primary navigation">{nav.map(([name,path])=><a href={href(path)} aria-current={current===href(path)?'page':undefined}>{name}</a>)}<a class="nav-contact" href={href('contact/')} aria-current={current===href('contact/')?'page':undefined}>Let’s connect <Icon name="arrow" size={16}/></a></nav>
        <details class="mobile-nav"><summary aria-label="Open navigation"><span>Menu</span><span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">{nav.map(([name,path])=><a href={href(path)}>{name}</a>)}<a href={href('contact/')}>Let’s connect</a></nav></details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot/></main>
    <footer class="site-footer"><div class="container"><div class="footer-top"><a class="brand" href={href()}><span class="brand-mark">MY<span>.</span></span><span>Engineering with purpose.<br/><span class="muted">Building with care.</span></span></a><div class="footer-links"><a href={href('projects/')}>Selected work</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="external" size={13}/></a><a href={href('contact/')}>Contact</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Mohamed Yousry</span><span>Embedded software. Security. Safety.</span><a href="#main">Back to top ↑</a></div></div></footer>
    <script>
      let cleanup = () => {};
      function observeMotion() {
        cleanup();
        const elements = document.querySelectorAll('.hero-art, .explorer, .case-diagram');
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => entry.target.classList.toggle('offscreen-motion', !entry.isIntersecting));
        });
        elements.forEach(element => observer.observe(element));
        const visibility = () => document.documentElement.classList.toggle('page-hidden', document.hidden);
        document.addEventListener('visibilitychange', visibility);
        cleanup = () => { observer.disconnect(); document.removeEventListener('visibilitychange', visibility); };
        visibility();
      }
      document.addEventListener('astro:page-load', observeMotion);
      document.addEventListener('astro:before-swap', () => cleanup());
    </script>
  </body>
</html>
